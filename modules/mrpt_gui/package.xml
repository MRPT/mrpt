<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mrpt_gui</name>
  <version>3.6.0</version>
  <description>The MRPT C++ library mrpt_gui</description>

  <maintainer email="joseluisblancoc@gmail.com">Jose-Luis Blanco-Claraco</maintainer>
  <license file="LICENSE">BSD</license>

  <url type="website">https://github.com/MRPT/</url>

  <buildtool_depend>cmake</buildtool_depend>

  <depend>mrpt_opengl</depend>

  <depend>eigen</depend> <!-- Needed by nanogui public headers -->
  <depend>libglfw3-dev</depend> <!-- Needed by nanogui public headers (GLFW/glfw3.h) -->

  <depend>libxrandr</depend>
  <depend>libxxf86vm</depend>
  <depend>opengl</depend>

  <build_depend>wx-common</build_depend>
  <depend>wxwidgets</depend>

  <depend>libqt5-opengl-dev</depend>
  <depend>qtbase5-dev</depend>

  <build_depend>pybind11-dev</build_depend>
  <build_depend>python3-dev</build_depend>

  <!-- Virtual X display for the headless window unit tests; they self-skip
       if no display is reachable, so this is only needed to actually run
       them (e.g. `xvfb-run -a colcon test`). -->
  <test_depend>xvfb</test_depend>

  <export>
    <build_type>cmake</build_type>
  </export>

</package>
